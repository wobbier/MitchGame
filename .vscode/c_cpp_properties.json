{
    "version": 4,
    "configurations": [
        {
            "name": "MitchEngine-Linux-Editor",
            "includePath": [
                "${workspaceFolder}/Engine/Source/**",
                "${workspaceFolder}/Engine/ThirdParty/**",
                "${workspaceFolder}/Game/Source/**",
                "${workspaceFolder}/Engine/Modules/**",
                "${workspaceFolder}/Engine/Modules/Havana/Source/**"
            ],
            "defines": [
                "DEFINE_ME_PLATFORM_LINUX",
                "DEFINE_ME_EDITOR",
                "DEFINE_ME_ULTRALIGHT",
                "DEFINE_ME_FMOD",
                "DEFINE_ME_OPTICK"
            ],
            "compilerPath": "/run/current-system/sw/bin/g++",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ]
}
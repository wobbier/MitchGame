{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ME HUB (Debug, Linux)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/Editor_Debug/HUB",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/Engine/Tools/HUB",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/Engine/Tools/NixGdb.sh",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Skip all files under /nix/store (stdlib, libc, etc.)",
          "text": "-interpreter-exec console \"skip -rfi /nix/store/.*\"",
          "ignoreFailures": true
        },
        {
          "description": "Set pagination off",
          "text": "-interpreter-exec console \"set pagination off\"",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build-me-hub-debug",
      "miDebuggerArgs": "--project \"${workspaceFolder}\""
    },

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Havana (Editor_Debug, Linux)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/Editor_Debug/Havana",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Skip all files under /nix/store (stdlib, libc, etc.)",
          "text": "-interpreter-exec console \"skip -rfi /nix/store/.*\"",
          "ignoreFailures": true
        },
        {
          "description": "Set pagination off",
          "text": "-interpreter-exec console \"set pagination off\"",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build-havana-editor-debug"
    }
  ]
}

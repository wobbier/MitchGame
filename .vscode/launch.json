{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Havana (Editor_Debug, Linux)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/Editor_Debug/Havana",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build-havana-editor-debug"
    }
  ]
}

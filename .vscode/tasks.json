{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "prepare-me-hub-assets",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/nix-env.sh",
      "args": [
        "bash",
        "${workspaceFolder}/.vscode/prepare-hub-assets.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "build-me-hub-debug",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/nix-env.sh",
      "args": [
        "make",
        "-f",
        "MitchGame.make",
        "HUB",
        "config=editor_debug",
        "-j$(nproc)"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "dependsOn": "prepare-me-hub-assets",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build-havana-editor-debug",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/nix-env.sh",
      "args": [
        "make",
        "-f",
        "MitchGame.make",
        "Havana",
        "config=editor_debug",
        "-j$(nproc)"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build-havana-game-debug",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/nix-env.sh",
      "args": [
        "make",
        "-f",
        "MitchGame.make",
        "Game_EntryPoint",
        "config=game_linux_debug",
        "-j$(nproc)"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build-me-hub-release",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/nix-env.sh",
      "args": [
        "make",
        "-f",
        "MitchGame.make",
        "HUB",
        "config=editor_release",
        "-j$(nproc)"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "dependsOn": "prepare-me-hub-assets",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build-havana-editor-release",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/nix-env.sh",
      "args": [
        "make",
        "-f",
        "MitchGame.make",
        "Havana",
        "config=editor_release",
        "-j$(nproc)"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build-havana-game-release",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/nix-env.sh",
      "args": [
        "make",
        "-f",
        "MitchGame.make",
        "Game_EntryPoint",
        "config=game_linux_release",
        "-j$(nproc)"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": "build-game-scripts-release"
    },
    {
      "label": "build-game-scripts-release",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/nix-env.sh",
      "args": [
        "dotnet",
        "build",
        "Project/Game.Script.csproj",
        "-c",
        "Release",
        "-o",
        ".build/Game_linux_Release",
        "--artifacts-path",
        ".tmp/dotnet",
        "--nologo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "build-me-hub-retail",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/nix-env.sh",
      "args": [
        "make",
        "-f",
        "MitchGame.make",
        "HUB",
        "config=editor_retail",
        "-j$(nproc)"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "dependsOn": "prepare-me-hub-assets",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build-havana-editor-retail",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/nix-env.sh",
      "args": [
        "make",
        "-f",
        "MitchGame.make",
        "Havana",
        "config=editor_retail",
        "-j$(nproc)"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build-havana-game-retail",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/nix-env.sh",
      "args": [
        "make",
        "-f",
        "MitchGame.make",
        "Game_EntryPoint",
        "config=game_linux_retail",
        "-j$(nproc)"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": "build-game-scripts-retail"
    },
    {
      "label": "build-game-scripts-retail",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/nix-env.sh",
      "args": [
        "dotnet",
        "build",
        "Project/Game.Script.csproj",
        "-c",
        "Release",
        "-o",
        ".build/Game_linux_Retail",
        "--artifacts-path",
        ".tmp/dotnet",
        "--nologo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    }
  ]
}

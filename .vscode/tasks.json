{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "prepare-me-hub-assets",
      "type": "process",
      "command": "${workspaceFolder}/Engine/Tools/NixEnv.sh",
      "args": [
        "--project",
        "${workspaceFolder}",
        "bash",
        "${workspaceFolder}/.vscode/prepare-hub-assets.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "build-me-hub-debug",
      "type": "process",
      "command": "${workspaceFolder}/Engine/Tools/BuildProject.sh",
      "args": [
        "HUB",
        "editor_debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "dependsOn": "prepare-me-hub-assets",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build-havana-editor-debug",
      "type": "process",
      "command": "${workspaceFolder}/Engine/Tools/BuildProject.sh",
      "args": [
        "Havana",
        "editor_debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build-havana-game-debug",
      "type": "process",
      "command": "${workspaceFolder}/Engine/Tools/BuildProject.sh",
      "args": [
        "Game_EntryPoint",
        "game_linux_debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build-me-hub-release",
      "type": "process",
      "command": "${workspaceFolder}/Engine/Tools/BuildProject.sh",
      "args": [
        "HUB",
        "editor_release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "dependsOn": "prepare-me-hub-assets",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build-havana-editor-release",
      "type": "process",
      "command": "${workspaceFolder}/Engine/Tools/BuildProject.sh",
      "args": [
        "Havana",
        "editor_release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build-havana-game-release",
      "type": "process",
      "command": "${workspaceFolder}/Engine/Tools/BuildProject.sh",
      "args": [
        "Game_EntryPoint",
        "game_linux_release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": "build-game-scripts-release"
    },
    {
      "label": "build-game-scripts-release",
      "type": "process",
      "command": "${workspaceFolder}/Engine/Tools/NixEnv.sh",
      "args": [
        "--project",
        "${workspaceFolder}",
        "dotnet",
        "build",
        "Project/Game.Script.csproj",
        "-c",
        "Release",
        "-o",
        ".build/Game_linux_Release",
        "--artifacts-path",
        ".tmp/dotnet",
        "--nologo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "build-me-hub-retail",
      "type": "process",
      "command": "${workspaceFolder}/Engine/Tools/BuildProject.sh",
      "args": [
        "HUB",
        "editor_retail"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "dependsOn": "prepare-me-hub-assets",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build-havana-editor-retail",
      "type": "process",
      "command": "${workspaceFolder}/Engine/Tools/BuildProject.sh",
      "args": [
        "Havana",
        "editor_retail"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build-havana-game-retail",
      "type": "process",
      "command": "${workspaceFolder}/Engine/Tools/BuildProject.sh",
      "args": [
        "Game_EntryPoint",
        "game_linux_retail"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": "build-game-scripts-retail"
    },
    {
      "label": "build-game-scripts-retail",
      "type": "process",
      "command": "${workspaceFolder}/Engine/Tools/NixEnv.sh",
      "args": [
        "--project",
        "${workspaceFolder}",
        "dotnet",
        "build",
        "Project/Game.Script.csproj",
        "-c",
        "Release",
        "-o",
        ".build/Game_linux_Retail",
        "--artifacts-path",
        ".tmp/dotnet",
        "--nologo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "build-server-debug",
      "type": "process",
      "command": "${workspaceFolder}/Engine/Tools/BuildProject.sh",
      "args": [
        "Game_EntryPoint",
        "server_linux_debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build-net-debug",
      "dependsOn": [
        "build-havana-game-debug",
        "build-server-debug"
      ],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Net: server + 2 clients",
      "type": "process",
      "command": "${workspaceFolder}/Engine/Tools/NixEnv.sh",
      "args": [
        "--project",
        "${workspaceFolder}",
        "python3",
        "Engine/Tools/RunNetLocal.py",
        "--scene",
        "${input:netScene}",
        "--clients",
        "2"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "build-net-debug",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Net: server + 2 clients (50 ms, 2% loss)",
      "type": "process",
      "command": "${workspaceFolder}/Engine/Tools/NixEnv.sh",
      "args": [
        "--project",
        "${workspaceFolder}",
        "python3",
        "Engine/Tools/RunNetLocal.py",
        "--scene",
        "${input:netScene}",
        "--clients",
        "2",
        "--net-args",
        "--net-lag 25 --net-jitter 5 --net-loss 1%"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "build-net-debug",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "netScene",
      "type": "promptString",
      "description": "Scene to play over the network",
      "default": "Assets/Scenes/Tests/NetTest.lvl"
    }
  ]
}

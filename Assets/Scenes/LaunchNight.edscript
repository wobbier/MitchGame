# Compile and preview the Launch Night shader graphs, then play the scene: the tour must move the camera.
# Engine/Tools/Headless.sh .build/Editor_Debug/Havana --scene Assets/Scenes/LaunchNight.lvl --editor-exec Assets/Scenes/LaunchNight.edscript
wait 30
assert-exists Main Camera
assert-exists The Last Developer
assert-exists Asleep On The Keyboard
assert-exists Compiling In The Beanbag
assert-exists Security Guard (Asleep)
assert-exists The Boss (On The Phone)
assert-exists Cleaner (Mopping)
assert-exists BUILD-01
assert-exists Camera Tour
sg-open Assets/ShaderGraphs/LaunchNight/CodeScreen.shadergraph
sg-assert-compiled
sg-wait-preview
sg-assert-preview
sg-close Assets/ShaderGraphs/LaunchNight/CodeScreen.shadergraph
sg-open Assets/ShaderGraphs/LaunchNight/Countdown.shadergraph
sg-assert-compiled
sg-wait-preview
sg-assert-preview
sg-close Assets/ShaderGraphs/LaunchNight/Countdown.shadergraph
sg-open Assets/ShaderGraphs/LaunchNight/BuildStatus.shadergraph
sg-assert-compiled
sg-wait-preview
sg-assert-preview
sg-close Assets/ShaderGraphs/LaunchNight/BuildStatus.shadergraph
sg-open Assets/ShaderGraphs/LaunchNight/BlueScreen.shadergraph
sg-assert-compiled
sg-wait-preview
sg-assert-preview
sg-close Assets/ShaderGraphs/LaunchNight/BlueScreen.shadergraph
sg-open Assets/ShaderGraphs/LaunchNight/Screensaver.shadergraph
sg-assert-compiled
sg-wait-preview
sg-assert-preview
sg-close Assets/ShaderGraphs/LaunchNight/Screensaver.shadergraph
sg-open Assets/ShaderGraphs/LaunchNight/Compiling.shadergraph
sg-assert-compiled
sg-wait-preview
sg-assert-preview
sg-close Assets/ShaderGraphs/LaunchNight/Compiling.shadergraph
sg-open Assets/ShaderGraphs/LaunchNight/CCTVServerRoom.shadergraph

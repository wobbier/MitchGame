# Build Game window (SHIP-3): File > Build Game builds a profile by running
# `Havana --build-game --profile <file>` as a child process and streaming its output.
#   ./.build/Editor_Debug/Havana --scene Assets/Scenes/Tests/UITest.lvl --editor-exec Assets/Scenes/Tests/BuildGameFlows.edscript
# Debug without compiling: RunChecks built that game first (its Build Game step proves Retail).
action File.BuildGame
wait 5
# Build & Run (ED-9): once the build succeeds it starts through its launcher, in its own folder; the
# game captures Run.png there and exits.
build-game {"Name": "Flow", "Configuration": "Debug", "Output": ".tmp/BuildGame/Flow", "Scenes": ["Assets/Scenes/Tests/UITest.lvl"], "Pak": true} | no-compile no-record run --frames 30 --no-audio --screenshot Run.png --exit
wait-log 'Flow' succeeded | 7200
build-game-wait
wait-file .tmp/BuildGame/Flow/Run.png | 3600
wait 5
screenshot .tmp/BuildGameFlows.png

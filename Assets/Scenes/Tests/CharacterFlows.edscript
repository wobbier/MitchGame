# --scene Assets/Scenes/Tests/CharacterTest.lvl
# First-person character (issue board #8): CharacterCore moves the Player with the Move action
# through the CharacterController (4 m/s walking, x1.6 sprinting), jumps on Jump and keeps the
# child Camera at eye height. Mouse look can't be injected from an edscript; the yaw/pitch path is
# the same code, exercised by hand in Play.
#   ./.build/Editor_Debug/Havana --scene Assets/Scenes/Tests/CharacterTest.lvl --editor-exec Assets/Scenes/Tests/CharacterFlows.edscript
wait-log dotnet ready | 7200
wait 30
assert-parent Camera | Player
play
wait 20
assert-field Player | Transform.Position.1 | 0.9 ~ 0.3
# Forward (W = Move +Y) walks along +Z at the walk speed.
input-hold Keyboard/W
wait-field Player | Transform.Position.2 | 6 ~ 2.5 | 900
input-release
wait 10
assert-field Player | Transform.Position.0 | 0 ~ 0.6
# The camera stays a child at eye height, aimed along the body.
assert-parent Camera | Player
assert-field Camera | Transform.Position | [0, 0.7, 0] ~ 0.05
assert-field Camera | Transform.Rotation | [0, 0, 0, 1] ~ 0.01
# Play-mode tests: a direct Jump(), a jump through the core from a held Space, walking speed.
console game-tests CharacterTests
wait-log GameTests: 3 passed, 0 failed | 3600
stop
wait 10
quit

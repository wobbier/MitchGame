# --scene Assets/Scenes/Tests/TerrainTest.lvl
# Scene-owned foliage, canonical placement, exact stroke history, renderer lifetime and Play/Stop.
wait 5
foliage-fixture
terrain-layout
foliage-radius 9
focus-window Terrain
action Edit.Undo
foliage-assert-radius 4
action Edit.Redo
foliage-assert-radius 9
foliage-stroke {"From":[-15,-10],"To":[12,8],"Species":0,"Radius":6,"Density":0.1,"Spacing":2}
foliage-mark
foliage-stroke {"From":[-18,10],"To":[15,12],"Species":1,"Radius":5,"Density":0.18,"Spacing":1,"MinScale":0.6,"MaxScale":1.4}
focus-window Terrain
action Edit.Undo
foliage-assert-mark
action Edit.Redo
foliage-stroke {"From":[-10,-5],"To":[12,-6],"Species":2,"Radius":6,"Density":0.12,"Spacing":1.4,"MinScale":0.4,"MaxScale":1.3,"Align":true}
wait 160
foliage-assert
foliage-mark
terrain-stroke {"From":[-5,-5],"To":[5,5],"Radius":10,"Strength":1}
foliage-reapply
foliage-assert
focus-window Terrain
action Edit.Undo
foliage-assert-mark
terrain-mode Sculpt
action Edit.Undo
terrain-mode Foliage
foliage-assert
foliage-mark
foliage-stroke {"From":[0,0],"To":[12,12],"Species":0,"Radius":10,"Erase":true,"Cancel":true}
foliage-assert-mark
foliage-stroke {"From":[0,0],"To":[12,12],"Species":0,"Radius":10,"Erase":true}
focus-window Terrain
action Edit.Undo
foliage-assert-mark
foliage-clear
wait 10
foliage-assert-hidden
focus-window Terrain
action Edit.Undo
foliage-assert-mark
wait 20
foliage-assert
foliage-distant
wait 10
foliage-assert-hidden
foliage-near
foliage-hide
wait 10
foliage-assert-hidden
foliage-show
wait 20
foliage-assert
screenshot .tmp/Foliage-Editor.png
save-as .tmp/Tests/FoliageScene.lvl
foliage-mark
play
wait 60
foliage-assert
screenshot .tmp/Foliage-Play.png
stop
wait 40
foliage-assert-mark
foliage-assert
quit

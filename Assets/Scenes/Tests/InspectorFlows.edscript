# The inspector's field search and lock (ED-7).
#   ./.build/Editor_Debug/Havana --scene Assets/Scenes/Tests/HierarchyTest.lvl --editor-exec Assets/Scenes/Tests/InspectorFlows.edscript
wait 20
show-window Properties
select Main Camera
wait 3
inspector-assert-entity Main Camera
inspector-assert-shows Transform | 1
inspector-assert-shows Camera.FieldOfView | 1

# A field search matches names and labels: only those fields, and components with none hide.
inspector-search clip
wait 3
inspector-assert-shows Camera.Near | 1
inspector-assert-shows Camera.Far | 1
inspector-assert-shows Camera.FieldOfView | 0
inspector-assert-shows Transform | 0
screenshot .tmp/overhaul/shots/inspector_search.png

# Matching a component's name shows it whole.
inspector-search transform
wait 3
inspector-assert-shows Transform.Position | 1
inspector-assert-shows Transform.Scale | 1
inspector-assert-shows Camera | 0
inspector-search
wait 3
inspector-assert-shows Camera.FieldOfView | 1

# Locked, the inspector stays on the camera while the light is selected; unlocked, it follows.
inspector-lock 1
select Directional Light
wait 3
inspector-assert-entity Main Camera
inspector-assert-shows Camera | 1
inspector-assert-shows Light | 0
inspector-lock 0
wait 3
inspector-assert-entity Directional Light
inspector-assert-shows Light.Intensity | 1

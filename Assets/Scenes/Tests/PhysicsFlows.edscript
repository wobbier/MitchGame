# Physics editor regression script (run with PhysicsTest.lvl):
#   ./.build/Editor_Debug/Havana --scene Assets/Scenes/Tests/PhysicsTest.lvl --editor-exec Assets/Scenes/Tests/PhysicsFlows.edscript
wait 20
mark-count

# Edit mode: nothing simulates; selected colliders draw their shapes, View > Physics draws the world
assert-field Ball 0 | Transform.Position | [3.0, 5.0, -1.0]
select Dumbbell
action View.Physics
wait 3
screenshot .tmp/overhaul/shots/physics_edit.png
action View.Physics

# Play: bodies fall and settle
play
wait 240
assert-playing 1
assert-field Stack 0 | Transform.Position.1 | 0.5 ~ 0.02
assert-field Stack 4 | Transform.Position.1 | 4.5 ~ 0.05
assert-field Dumbbell | Transform.Position.1 | 0.4 ~ 0.05
screenshot .tmp/overhaul/shots/physics_play.png

# Stop restores the edit-time poses
stop
wait 5
assert-playing 0
assert-field Ball 0 | Transform.Position | [3.0, 5.0, -1.0]
assert-field Dumbbell | Transform.Position | [-2.5, 6.0, -2.0]
assert-count-delta 0

# A second session starts from fresh bodies
play
wait 30
assert-playing 1
stop
wait 5
assert-field Ball 0 | Transform.Position | [3.0, 5.0, -1.0]
assert-count-delta 0

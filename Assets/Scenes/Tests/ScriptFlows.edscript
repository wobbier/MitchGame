# C# scripting regression script (run with ScriptTest.lvl):
#   ./.build/Editor_Debug/Havana --scene Assets/Scenes/Tests/ScriptTest.lvl --editor-exec Assets/Scenes/Tests/ScriptFlows.edscript
# Assets/Scripts/Tests/ScriptProbe.cs makes every effect visible on the Probe's Transform.
wait 20
mark-count

# Edit mode: the script exists (fields loaded) but doesn't run
assert-field Probe | Transform.Position | [0.0, 1.0, 0.0]
assert-field Probe | Transform.Scale | [1.0, 1.0, 1.0]
wait 30
assert-field Probe | Transform.Position | [0.0, 1.0, 0.0]

# Play: OnStart raycasts to the Ground by name (scale 2), OnUpdate rises, OnFixedUpdate turns
play
# Local multiplayer input is reachable from C#; renamed script class and field ([FormerName]) still load
wait-log ScriptProbe: 1 input player(s), player 0 pad -1 | 600
wait-log ScriptProbe schema: 3 fields | 600
wait-log RenameProbe: started with Value 7 | 600
# Physics callbacks: the Dropper falls through the Gate trigger and lands on the Ground
wait-log TriggerProbe: Dropper entered | 600
wait-log TriggerProbe: Dropper left | 600
wait-log CollisionProbe: hit Ground (normal y -1.0) | 600
# [ExecutionOrder] beats scene order; OnLateUpdate follows every OnUpdate
wait-log OrderProbe: execution order and late update held for 30 frames | 600
# Additive scenes stream in the background, then unload as a unit
wait-log StreamProbe: chunk loaded | 600
wait-log StreamProbe: chunk unloaded | 600
wait 60
assert-playing 1
assert-field Probe | Transform.Scale | [2.0, 2.0, 2.0]
assert-field Probe | Transform.Position.1 | != 1.0
assert-field Probe | Transform.Rotation | != [0.0, 0.0, 0.0, 1.0]
screenshot .tmp/overhaul/shots/script_play.png

# Generic component access from C#: ScriptProbe doubled the sun and recoloured it
assert-field Sun | Light.Intensity | 6.0
assert-field Sun | Light.Color | [1.0, 0.5, 0.25]

# Hot reload while playing: change the probe's code; the new code runs and fields carry over
assert-field Reloader | Transform.Scale | [1.0, 1.0, 1.0]
replace-in-file Assets/Scripts/Tests/HotReloadProbe.cs | float version = 1.0f; | float version = 3.0f;
wait-log Scripts: hot reloaded | 3600
wait 5
assert-field Reloader | Transform.Scale | [3.0, 3.0, 3.0]
assert-field Reloader | Transform.Position.0 | 0.5 ~ 0.495
replace-in-file Assets/Scripts/Tests/HotReloadProbe.cs | float version = 3.0f; | float version = 1.0f;
wait-log Scripts: hot reloaded | 3600
wait 5
assert-field Reloader | Transform.Scale | [1.0, 1.0, 1.0]

# An exception reaches the Log with its whole stack, down to the throwing line
replace-in-file Assets/Scripts/Tests/HotReloadProbe.cs | public int Ticks = 0; | public int Ticks = 0; static bool s_thrown;
wait-log Scripts: hot reloaded | 3600
replace-in-file Assets/Scripts/Tests/HotReloadProbe.cs | Ticks++; | Ticks++; if( !s_thrown ) { s_thrown = true; throw new System.InvalidOperationException( "probe throw" ); }
wait-log probe throw | 3600
wait-log HotReloadProbe.cs:line 11 | 600
# ...and with Pause on script exception on (ME-234), the next throw pauses Play and selects the thrower
preference Editor.PauseOnScriptException | true
replace-in-file Assets/Scripts/Tests/HotReloadProbe.cs | throw new System.InvalidOperationException( "probe throw" ); | throw new System.InvalidOperationException( "second throw" );
wait-log Paused: Reloader's script threw | 3600
assert-paused 1
assert-active Reloader
pause
wait 2
assert-paused 0
preference Editor.PauseOnScriptException | false
replace-in-file Assets/Scripts/Tests/HotReloadProbe.cs | throw new System.InvalidOperationException( "second throw" ); | throw new System.InvalidOperationException( "probe throw" );
wait-log Scripts: hot reloaded | 3600
replace-in-file Assets/Scripts/Tests/HotReloadProbe.cs | Ticks++; if( !s_thrown ) { s_thrown = true; throw new System.InvalidOperationException( "probe throw" ); } | Ticks++;
wait-log Scripts: hot reloaded | 3600
replace-in-file Assets/Scripts/Tests/HotReloadProbe.cs | public int Ticks = 0; static bool s_thrown; | public int Ticks = 0;
wait-log Scripts: hot reloaded | 3600

# Stop restores the scene
stop
wait 5
assert-playing 0
assert-field Probe | Transform.Position | [0.0, 1.0, 0.0]
assert-field Probe | Transform.Scale | [1.0, 1.0, 1.0]
assert-field Reloader | Transform.Position | [0.0, 3.0, 0.0]
assert-field Sun | Light.Intensity | 3.0
assert-field Dropper | Transform.Position | [4.0, 4.0, 0.0]
assert-count-delta 0

# A compile error is logged per line (file:line, clickable), and Play waits until the scripts build
replace-in-file Assets/Scripts/Tests/HotReloadProbe.cs | float version = 1.0f; | float version = 1.0f
wait-log Assets/Scripts/Tests/HotReloadProbe.cs:12: | 3600
wait-log error CS1002 | 600
# ...and stays in the Error List (ME-233) until the scripts build again
assert-build-errors 1
show-window Error List
wait 2
play
wait 5
assert-playing 0
replace-in-file Assets/Scripts/Tests/HotReloadProbe.cs | float version = 1.0f | float version = 1.0f;
wait-log Scripts: hot reloaded | 3600
assert-build-errors 0
play
wait 5
assert-playing 1
stop
wait 5
assert-playing 0

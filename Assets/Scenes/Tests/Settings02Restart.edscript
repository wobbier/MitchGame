# --scene Assets/Scenes/Tests/SettingsTest.lvl --user-dir .tmp/EditorFlows/SettingsUser
# Player settings (PLAY-2), second launch: what Settings01Write saved came back at boot.
# Run after Settings01Write (RunEditorFlows --only Settings runs both in order).
wait-log dotnet ready | 7200
wait 30

# Loaded and applied before the first frame: no settings-reload here.
settings-assert Graphics.Quality | "Low"
settings-assert Audio.Music | 0.25
settings-assert Accessibility.ReduceMotion | true
settings-assert Game.Probe | 7
settings-assert Input.Bindings | {"Gameplay/Jump/0": "Keyboard/J"}

# The script reads them back, and the restored rebind drives the game: J jumps, Space doesn't.
play
wait-log SettingsProbe: quality=Low music=0.25 probe=7 jump=J reduce-motion=True | 600
input-hold Keyboard/J
wait-log SettingsProbe: jump 1 | 300
assert-action Jump | true
input-release
wait 3
input-hold Keyboard/Space
wait 5
assert-action Jump | false
input-release
stop
wait 5

# Leave the folder at the defaults.
settings-reset
settings-save
settings-reload
settings-assert Input.Bindings | {}
quit

# --scene Assets/Scenes/Tests/ScriptTest.lvl
# Splines (GAME-2): the component's curve in world space from C++ (assert-spline) and C#
# (Assets/Scripts/Tests/SplineProbe.cs through the console) agree, through a moved, rotated and
# scaled entity and a closed loop; dragging a point's handle in the World view edits it, one undo
# step per drag.
wait-log dotnet ready | 7200
wait 5
create Path
select Path
add-component Spline
set Transform.Position [0,1,0]
set Spline.Points [[0,0,0],[2,0,0],[2,0,2],[0,0,2]]
wait 2
assert-spline Path | point 1 | 2 0 0
assert-spline Path | 0 | 0 1 0
assert-spline Path | 0.5 | 2.25 1 1
assert-spline Path | 0.25 | 1.641 1 -0.141
assert-spline Path | length | 6.186
console spline-check Path 0.5 2.25 1 1
assert-console-output ok
console spline-check Path length 6.186
assert-console-output ok

# Rotated a quarter turn about Y and doubled.
set Transform.Rotation [0,90,0]
set Transform.Scale [2,2,2]
wait 2
assert-spline Path | 0.5 | 2 1 -4.5
assert-spline Path | 0.25 | -0.281 1 -3.281
assert-spline Path | length | 12.371
console spline-check Path 0.5 2 1 -4.5
assert-console-output ok
console spline-check Path 0.25 -0.281 1 -3.281
assert-console-output ok
console spline-check Path length 12.371
assert-console-output ok

# A closed loop.
set Transform.Rotation [0,0,0]
set Transform.Scale [1,1,1]
set Spline.Closed true
wait 2
assert-spline Path | 0.5 | 2 1 2
assert-spline Path | length | 8.404
console spline-check Path 0.25 2 1 0
assert-console-output ok
console spline-check Path length 8.404
assert-console-output ok

# Drag point 1's handle across the World view; undo puts it back, redo moves it again.
set Spline.Closed false
action View.FrameSelected
wait 10
spline-handle-mouse 1
scene-mouse-down
wait 3
scene-mouse-offset 80 0
wait 3
scene-mouse-offset 80 0
wait 3
scene-mouse-up
wait 3
assert-spline Path | point 1 | != 2 0 0
screenshot .tmp/EditorFlows/SplineFlows.png
undo
assert-spline Path | point 1 | 2 0 0
redo
assert-spline Path | point 1 | != 2 0 0

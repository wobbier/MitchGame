# --scene Assets/Scenes/Tests/TerrainTest.lvl
# Compressed version 5 pages retain exact canonical heights, painted weights and collision.
wait 5
terrain-stream-paged-fixture compressed-painted
terrain-stream-paged-cook-wait
terrain-stream-paged-bind
terrain-layout
terrain-mode Inspect
wait 180
terrain-stream-paged-wait
wait 60
terrain-stream-paged-assert
terrain-stream-paged-assert-compressed
screenshot .tmp/TerrainCompressed-Near.png
terrain-stream-paged-camera -32
wait 100
terrain-stream-paged-assert
terrain-stream-paged-assert-compressed
terrain-stream-paged-coarse-only
wait 80
terrain-stream-paged-assert
terrain-stream-paged-assert-compressed
terrain-stream-paged-save
play
wait 100
terrain-stream-paged-assert
terrain-stream-paged-assert-compressed
terrain-stream-paged-mark
terrain-stream-paged-teleport 168
wait 180
terrain-stream-paged-wait
wait 60
terrain-stream-paged-evicted
screenshot .tmp/TerrainCompressed-Far.png
stop
wait 150
terrain-stream-paged-assert
terrain-stream-paged-assert-compressed
quit

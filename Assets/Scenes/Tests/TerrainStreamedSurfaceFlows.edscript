# --scene Assets/Scenes/Tests/TerrainTest.lvl
# Painted version 4 pages retain full-resolution weights, shared maps and collision while travelling.
wait 5
terrain-stream-paged-fixture painted
terrain-stream-paged-cook-wait
terrain-stream-paged-bind
terrain-layout
terrain-mode Inspect
wait 180
terrain-stream-paged-wait
wait 60
terrain-stream-paged-assert
screenshot .tmp/TerrainStreamedSurface-Near.png
terrain-stream-paged-camera -32
wait 100
terrain-stream-paged-assert
terrain-stream-paged-coarse-only
wait 80
terrain-stream-paged-assert
terrain-stream-paged-save
play
wait 100
terrain-stream-paged-assert
terrain-stream-paged-mark
terrain-stream-paged-teleport 168
wait 180
terrain-stream-paged-wait
wait 60
terrain-stream-paged-evicted
screenshot .tmp/TerrainStreamedSurface-Far.png
stop
wait 150
terrain-stream-paged-assert
quit

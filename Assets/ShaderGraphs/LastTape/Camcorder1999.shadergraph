			"Settings": {
				"Code": "float white = max(Glyph*Active,Battery)*OSD;\nvec3 image = mix(Image,vec3(0.91,0.96,0.93),white*.9);\nimage = mix(image,vec3(0.94,0.13,0.08),Dot*OSD);\nColor = image * Mask;",

		{
			"Id": 10,
			"Position": [
				-1250.0,
				-200.0
			],
			"Settings": {
				"Code": "// 480-line capture, mild lens bow and horizontal transport instability.\nfloat frame = floor(Clock * 29.97);\nfloat row = floor(UV.y * 480.0);\nfloat rowNoise = fract(sin(row * 12.9898 + frame * 4.1414) * 43758.5453) - 0.5;\nfloat tracking = smoothstep(0.972, 0.998, UV.y);\nfloat splice = step(0.987, fract(Clock * 0.071));\nvec2 p = UV - vec2_splat(0.5);\nvec2 warped = UV + p * dot(p,p) * 0.032 * Wear;\nwarped.x += Wear * (rowNoise * 0.00065 + sin(Clock*1.7) * 0.00018\n             + tracking * rowNoise * 0.006 + splice * sin(row*.14) * 0.002);\nfloat aspect = u_viewRect.z / max(u_viewRect.w, 1.0);\nvec2 raster = vec2(480.0 * aspect, 480.0);\nvec2 lowRes = (floor(warped * raster) + vec2_splat(0.5)) / raster;\nCenter = mix(UV, lowRes, Wear * 0.78);\nRed = Center + vec2(Bleed * Wear / raster.x, 0.0);\nBlue = Center - vec2(Bleed * Wear * 0.65 / raster.x, 0.0);\nSoft = Center + vec2(3.5 * Wear / raster.x, 0.0);",
				"Inputs": [
					{
						"Name": "UV",
						"Type": "Vec2"
					},
					{
						"Name": "Clock",
						"Type": "Float"
					},
					{
						"Name": "Wear",
						"Type": "Float"
					},
					{
						"Name": "Bleed",
						"Type": "Float"
					}
				],
				"Name": "TapeTransport",
				"Outputs": [
					{
						"Name": "Center",
						"Type": "Vec2"
					},
					{
						"Name": "Red",
						"Type": "Vec2"
					},
					{
						"Name": "Blue",
						"Type": "Vec2"
					},
					{
						"Name": "Soft",
						"Type": "Vec2"
					}
				]
			},
			"Type": "CustomFunction"
		},
		{
			"Id": 11,
			"Position": [
				-850.0,
				-350.0
			],
			"Type": "SceneColor"
		},
		{
			"Id": 12,
			"Position": [
				-850.0,
				-140.0
			],
			"Type": "SceneColor"
		},
		{
			"Id": 13,
			"Position": [
				-850.0,
				70.0
			],
			"Type": "SceneColor"
		},
		{
			"Id": 14,
			"Position": [

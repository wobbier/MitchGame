				280.0
			],
			"Type": "SceneColor"
		},
		{
			"Id": 15,
			"Position": [
				-350.0,
				-150.0
			],
			"Settings": {
				"Code": "vec3 signal = vec3(Red.r, Center.g, Blue.b);\nfloat luma = dot(signal, vec3(0.299, 0.587, 0.114));\nfloat softLuma = dot(Soft, vec3(0.299, 0.587, 0.114));\nvec3 chroma = Soft - vec3_splat(softLuma);\nsignal = mix(signal, vec3_splat(luma) + chroma * 0.78, Wear * 0.32);\n// A consumer CCD: soft highlight knee, lifted blacks and a green/cyan bias.\nsignal = pow(max(signal, vec3_splat(0.0)), vec3_splat(0.96));\nsignal = signal * vec3(0.98, 1.01, 1.025) + vec3(0.008, 0.012, 0.014) * Wear;\nfloat frame = floor(Clock * 29.97);\nvec2 pixel = floor(UV * vec2(640.0,480.0));\nfloat noise = fract(sin(dot(pixel,vec2(12.9898,78.233)) + frame*3.119) * 43758.5453) - 0.5;\nfloat chromaNoise = fract(sin(dot(pixel,vec2(39.346,11.135)) + frame*1.719) * 47453.5453) - 0.5;\nsignal += (vec3_splat(noise) + vec3(chromaNoise,0.0,-chromaNoise)*0.25) * Grain * (1.4-luma*.65) * Wear;\nfloat scan = sin(UV.y*480.0*3.14159265 + mod(frame,2.0)*3.14159265);\nsignal *= 1.0 - (0.014 + scan*0.009) * Wear;\nvec2 p = (UV - vec2_splat(0.5)) * vec2(1.12,1.0);\nsignal *= 1.0 - smoothstep(0.18,0.72,length(p)) * Vignette;\n// A narrow head-switching band, kept below the picture and away from faces.\nfloat tracking = smoothstep(0.976,0.999,UV.y);\nsignal = mix(signal, vec3_splat(0.10+noise*.16), tracking*Wear*.32);\nColor = clamp(signal,vec3_splat(0.0),vec3_splat(1.0));",
				"Inputs": [
					{
						"Name": "Center",
						"Type": "Vec3"
					},
					{
						"Name": "Red",
						"Type": "Vec3"
					},
					{
						"Name": "Blue",
						"Type": "Vec3"
					},
					{
						"Name": "Soft",
						"Type": "Vec3"
					},
					{
						"Name": "UV",
						"Type": "Vec2"
					},
					{
						"Name": "Clock",
						"Type": "Float"
					},
					{
						"Name": "Wear",
						"Type": "Float"
					},
					{
						"Name": "Grain",
						"Type": "Float"
					},
					{
						"Name": "Vignette",
						"Type": "Float"
					}
				],
				"Name": "Hi8Signal",
				"Outputs": [

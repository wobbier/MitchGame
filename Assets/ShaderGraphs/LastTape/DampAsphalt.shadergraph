			"Settings": {
				"Code": "vec2 p = World.xz;\nfloat grit = fract(sin(dot(floor(p*160.0),vec2(12.9898,78.233)))*43758.5453);\nfloat wetPatch = sgValueNoise(p*.37,1.0);\nfloat damp = smoothstep(.36,.68,wetPatch)*Wet;\nAlbedo = mix(vec3(.055,.068,.083),vec3(.022,.033,.044),damp) * (.82+grit*.3);\nRoughness = mix(.88,.23,damp);\nNormal = normalize(vec3((grit-.5)*.045,(wetPatch-.5)*.045,1.0));",
				"Inputs": [
					{
						"Name": "World",
						"Type": "Vec3"

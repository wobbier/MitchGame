        {
            "Id": 14,
            "Type": "CustomFunction",
            "Settings": {
                "Name": "Feed",
                "Inputs": [
                    {
                        "Name": "UV",
                        "Type": "Vec2"
                    },
                    {
                        "Name": "Time",
                        "Type": "Float"
                    },
                    {
                        "Name": "Hot",
                        "Type": "Vec2"
                    },
                    {
                        "Name": "FireAmount",
                        "Type": "Float"
                    }
                ],
                "Outputs": [
                    {
                        "Name": "Gray",
                        "Type": "Float"
                    },
                    {
                        "Name": "Fire",
                        "Type": "Float"
                    },
                    {
                        "Name": "Backing",
                        "Type": "Float"
                    }
                ],
                "Code": "float t = Time;\nfloat roll = fract(UV.y * 0.9 - t * 0.17);\nfloat band = smoothstep(0.0, 0.05, roll) * (1.0 - smoothstep(0.05, 0.12, roll));\nfloat n = fract(sin(dot(floor(UV * vec2(320.0, 240.0)) + floor(t * 24.0) * 1.37, vec2(12.9898, 78.233))) * 43758.5453);\nfloat shade = 0.025 + 0.11 * smoothstep(1.0, 0.25, UV.y) + 0.04 * step(0.62, UV.y);\nvec2 c = (UV - Hot) * vec2(1.6, 1.0);\nfloat flicker = 0.75 + 0.25 * sin(t * 13.0) * sin(t * 7.3);\nfloat flame = (exp(-dot(c, c) * 22.0) * 1.6 + exp(-dot(c, c) * 4.0) * 0.35) * flicker;\nfloat rack = step(0.5, fract(UV.x * 9.0)) * step(0.3, UV.y) * step(UV.y, 0.8);\nfloat leds = rack * step(0.82, fract(sin(dot(floor(UV * vec2(36.0, 40.0)), vec2(7.13, 3.71))) * 917.13)) * 0.22;\nGray = shade * (1.0 - rack * 0.6) + leds + n * 0.05 + band * 0.07;\nFire = flame * FireAmount;\nBacking = FireAmount * step(0.19, UV.x) * step(UV.x, 0.81) * step(0.69, UV.y) * step(UV.y, 0.84);"
            },
            "Defaults": {
                "Hot": [
                    0.62,
                    0.5,
                    0.0,
                    0.0
                ],
                "FireAmount": [
                    0.0,
                    0.0,
                    0.0,
                    0.0
                ]
            },
            "Position": [
                -1040,
                -300
            ]
        },

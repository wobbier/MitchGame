            ]
        },
        {
            "Id": 7,
            "Type": "CustomFunction",
            "Settings": {
                "Name": "City",
                "Inputs": [
                    {
                        "Name": "P",
                        "Type": "Vec3"
                    },
                    {
                        "Name": "N",
                        "Type": "Vec3"
                    },
                    {
                        "Name": "Time",
                        "Type": "Float"
                    }
                ],
                "Outputs": [
                    {
                        "Name": "Emit",
                        "Type": "Vec3"
                    },
                    {
                        "Name": "Window",
                        "Type": "Float"
                    }
                ],
                "Code": "vec3 an = abs(N);\nvec2 uv = an.x > an.z ? P.zy : P.xy;\nvec2 gp = uv / vec2(3.1, 3.5);\nvec2 id = floor(gp);\nvec2 fp = fract(gp);\nfloat win = step(0.16, fp.x) * step(fp.x, 0.84) * step(0.22, fp.y) * step(fp.y, 0.84);\nfloat n = fract(sin(dot(id + floor(P.xz * 0.05) * 13.0, vec2(12.9898, 78.233)) + floor(an.x * 1.5) * 3.1) * 43758.5453);\nfloat lit = step(0.64, n);\nfloat tv = step(0.64, n) * step(n, 0.67) * (0.5 + 0.5 * sin(Time * (3.0 + n * 9.0) + n * 40.0));\nvec3 warm = vec3(1.0, 0.72, 0.42);\nvec3 cool = vec3(0.6, 0.78, 1.0);\nvec3 col = fract(n * 31.7) < 0.7 ? warm : cool;\ncol = mix(col, vec3(0.3, 0.5, 1.0), step(0.0001, tv));\nfloat side = step(an.y, 0.5);\nEmit = col * win * lit * side * (0.4 + 0.6 * fract(n * 17.3)) * (1.0 - 0.6 * tv);\nWindow = win * side;"
            },
            "Position": [
                640,
                80
            ]
        },

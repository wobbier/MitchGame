        {
            "Id": 17,
            "Type": "CustomFunction",
            "Settings": {
                "Name": "CodeLines",
                "Inputs": [
                    {
                        "Name": "UV",
                        "Type": "Vec2"
                    },
                    {
                        "Name": "Time",
                        "Type": "Float"
                    },
                    {
                        "Name": "Speed",
                        "Type": "Float"
                    },
                    {
                        "Name": "Seed",
                        "Type": "Float"
                    }
                ],
                "Outputs": [
                    {
                        "Name": "Color",
                        "Type": "Vec3"
                    }
                ],
                "Code": "float rows = 26.0;\nfloat yy = UV.y * rows + Time * Speed;\nfloat row = floor(yy);\nfloat fy = fract(yy);\nfloat h = fract(sin(row * 12.9898 + Seed * 78.233) * 43758.5453);\nfloat h2 = fract(sin(row * 39.346 + Seed * 11.135) * 24634.6345);\nfloat cols = 70.0;\nfloat indent = floor(h2 * 4.0) * 2.0;\nfloat gutter = UV.x * cols;\nfloat cx = gutter - 4.0 - indent;\nfloat c = floor(cx);\nfloat fx = fract(cx);\nfloat len = floor(6.0 + h * 44.0);\nfloat hc = fract(sin((c + row * 97.0) * 7.31 + Seed) * 9137.17);\nfloat word = floor((c + floor(h * 7.0)) / 5.0);\nfloat hw = fract(sin((word + row * 31.0) * 3.17 + Seed * 1.7) * 5131.7);\nfloat blank = step(h, 0.1);\nfloat ink = step(0.0, c) * step(c, len) * step(0.15, hc) * (1.0 - blank);\nfloat glyph = step(0.2, fy) * step(fy, 0.76) * step(0.12, fx) * step(fx, 0.88);\nvec3 col = vec3(0.82, 0.85, 0.9);\nif (hw < 0.2) col = vec3(0.78, 0.45, 0.98);\nelse if (hw < 0.34) col = vec3(1.0, 0.62, 0.3);\nelse if (hw < 0.52) col = vec3(0.36, 0.68, 1.0);\nif (h2 > 0.86) col = vec3(0.4, 0.75, 0.38);\nfloat numbers = step(gutter, 2.6) * step(0.4, fract(sin(row * 3.3) * 91.7)) * glyph;\nfloat cursor = step(abs(UV.y - 0.93), 0.016) * step(abs(UV.x - (0.06 + fract(Time * 0.37 + Seed) * 0.5)), 0.008) * step(0.5, fract(Time * 1.6));\nColor = col * ink * glyph + vec3(0.25, 0.27, 0.32) * numbers + vec3(0.9, 0.9, 0.9) * cursor;"
            },
            "Position": [
                80,
                -110
            ]
        },

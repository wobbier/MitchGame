        {
            "Id": 18,
            "Type": "CustomFunction",
            "Settings": {
                "Name": "Drips",
                "Inputs": [
                    {
                        "Name": "World",
                        "Type": "Vec2"
                    },
                    {
                        "Name": "Time",
                        "Type": "Float"
                    }
                ],
                "Outputs": [
                    {
                        "Name": "Ripple",
                        "Type": "Float"
                    }
                ],
                "Code": "float h = 0.0;\nvec2 g = World * 1.6;\nfor (int i = 0; i < 2; i++)\n{\n    vec2 id = floor(g + vec2_splat(float(i) * 0.5));\n    vec2 fp = fract(g + vec2_splat(float(i) * 0.5)) - vec2_splat(0.5);\n    float n = fract(sin(dot(id, vec2(12.9898, 78.233)) + float(i) * 7.1) * 43758.5453);\n    float life = fract(Time * 0.9 + n);\n    vec2 o = vec2(fract(n * 13.1), fract(n * 71.7)) * 0.5 - vec2_splat(0.25);\n    float d = length(fp - o);\n    float ring = sin((d - life * 0.45) * 70.0) * (1.0 - smoothstep(0.0, 0.06, abs(d - life * 0.45)));\n    h += ring * (1.0 - life) * step(0.25, n);\n}\nRipple = h * 0.5 + 0.5;"
            },
            "Position": [
                360,
                80
            ]
        },

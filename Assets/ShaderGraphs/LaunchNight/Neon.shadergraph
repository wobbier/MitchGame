        {
            "Id": 16,
            "Type": "CustomFunction",
            "Settings": {
                "Name": "Buzz",
                "Inputs": [
                    {
                        "Name": "Time",
                        "Type": "Float"
                    },
                    {
                        "Name": "Rate",
                        "Type": "Float"
                    },
                    {
                        "Name": "Seed",
                        "Type": "Float"
                    }
                ],
                "Outputs": [
                    {
                        "Name": "Buzz",
                        "Type": "Float"
                    }
                ],
                "Code": "float t = Time * Rate;\nfloat k = floor(t);\nfloat n = fract(sin(k * 12.9898 + Seed) * 43758.5453);\nfloat drop = step(0.9, n) * step(fract(t), 0.35);\nBuzz = (1.0 - drop * 0.85) * (0.94 + 0.06 * sin(Time * 120.0));"
            },
            "Position": [
                80,
                -110
            ]
        },

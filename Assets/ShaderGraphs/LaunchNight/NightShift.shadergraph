        {
            "Id": 18,
            "Type": "CustomFunction",
            "Settings": {
                "Name": "NightShift",
                "Inputs": [
                    {
                        "Name": "UV",
                        "Type": "Vec2"
                    },
                    {
                        "Name": "Time",
                        "Type": "Float"
                    }
                ],
                "Outputs": [
                    {
                        "Name": "Grain",
                        "Type": "Float"
                    },
                    {
                        "Name": "Alarm",
                        "Type": "Float"
                    }
                ],
                "Code": "float n = fract(sin(dot(floor(UV * vec2(960.0, 540.0)) + vec2_splat(fract(Time * 7.0) * 113.0), vec2(12.9898, 78.233))) * 43758.5453);\nvec2 c = UV - vec2_splat(0.5);\nfloat edge = smoothstep(0.25, 0.75, length(c * vec2(1.3, 1.0)));\nfloat pulse = 0.5 + 0.5 * sin(Time * 4.4);\nGrain = (n - 0.5);\nAlarm = edge * pulse * pulse;"
            },
            "Position": [
                80,
                650
            ]
        },

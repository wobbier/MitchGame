        {
            "Id": 12,
            "Type": "CustomFunction",
            "Settings": {
                "Name": "RainDrops",
                "Inputs": [
                    {
                        "Name": "P",
                        "Type": "Vec2"
                    },
                    {
                        "Name": "Time",
                        "Type": "Float"
                    },
                    {
                        "Name": "Scale",
                        "Type": "Float"
                    }
                ],
                "Outputs": [
                    {
                        "Name": "Height",
                        "Type": "Float"
                    }
                ],
                "Code": "vec2 p = P * Scale;\nfloat h = 0.0;\n{\n    vec2 uv = p * 22.0;\n    vec2 id = floor(uv);\n    vec2 fp = fract(uv) - vec2_splat(0.5);\n    float n = fract(sin(dot(id, vec2(12.9898, 78.233))) * 43758.5453);\n    vec2 o = vec2(fract(n * 13.1), fract(n * 71.7)) - vec2_splat(0.5);\n    float r = 0.1 + 0.16 * fract(n * 7.3);\n    float life = fract(Time * (0.05 + 0.1 * fract(n * 3.7)) + n);\n    float d = length(fp - o * 0.5);\n    h = max(h, (1.0 - smoothstep(r * 0.4, r, d)) * step(0.72, n) * smoothstep(1.0, 0.7, life));\n}\n{\n    float cw = 0.16;\n    float colx = floor(p.x / cw);\n    float n = fract(sin(colx * 78.233 + 1.3) * 43758.5453);\n    float x = (fract(p.x / cw) - 0.5) * cw + sin(p.y * 6.0 + n * 6.28) * 0.012;\n    float s = p.y / 0.9 + Time * (0.18 + 0.3 * n) + n * 7.0;\n    float cycle = floor(s);\n    float dy = (fract(s) - 0.5) * 0.9;\n    float m = fract(sin((cycle + colx * 13.0) * 12.9898) * 43758.5453);\n    float head = 1.0 - smoothstep(0.008, 0.016, length(vec2(x, dy * 0.75)));\n    float trailMask = step(0.0, dy) * (1.0 - smoothstep(0.0, 0.32, dy));\n    float trail = (1.0 - smoothstep(0.002, 0.005, abs(x))) * trailMask;\n    float bead = fract(dy * 26.0);\n    float beads = (1.0 - smoothstep(0.003, 0.007, length(vec2(x, (bead - 0.5) / 26.0)))) * trailMask * step(0.45, fract(sin(floor(dy * 26.0) + m * 40.0) * 917.3));\n    h = max(h, (head + max(trail * 0.35, beads * 0.8)) * step(0.3, m));\n}\nHeight = h;"
            },
            "Position": [
                80,
                -300
            ]
        },

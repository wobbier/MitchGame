        {
            "Id": 14,
            "Type": "CustomFunction",
            "Settings": {
                "Name": "Bounce",
                "Inputs": [
                    {
                        "Name": "UV",
                        "Type": "Vec2"
                    },
                    {
                        "Name": "Time",
                        "Type": "Float"
                    }
                ],
                "Outputs": [
                    {
                        "Name": "Local",
                        "Type": "Vec2"
                    },
                    {
                        "Name": "Tint",
                        "Type": "Vec3"
                    }
                ],
                "Code": "float w = 0.33;\nfloat hgt = 0.16;\nfloat tx = Time * 0.083;\nfloat ty = Time * 0.061;\nvec2 o = vec2(abs(fract(tx) * 2.0 - 1.0) * (1.0 - w), abs(fract(ty) * 2.0 - 1.0) * (1.0 - hgt));\nLocal = UV - o;\nfloat bounces = floor(tx * 2.0) + floor(ty * 2.0);\nTint = vec3_splat(0.5) + 0.5 * cos(6.2831853 * (bounces * 0.27 + vec3(0.0, 0.33, 0.67)));"
            },
            "Position": [
                -200,
                -300
            ]
        },
        {
            "Id": 15,
            "Type": "CustomFunction",
            "Settings": {
                "Name": "Sleepy",
                "Inputs": [
                    {
                        "Name": "UV",
                        "Type": "Vec2"
                    }
                ],
                "Outputs": [
                    {
                        "Name": "Mask1",
                        "Type": "Float"
                    },
                    {
                        "Name": "Mask2",
                        "Type": "Float"
                    },
                    {
                        "Name": "Mask3",
                        "Type": "Float"
                    }
                ],
                "Code": "Mask1 = 0.0;\nMask2 = 0.0;\nMask3 = 0.0;\n{\n    vec2 q = vec2((UV.x - 0.0) / 0.085714, (UV.y - 0.0) / 0.16);\n    if (q.y >= 0.0 && q.y < 1.0 && q.x >= 0.0 && q.x < 6.0)\n    {\n        float ci = floor(q.x);\n        float px = floor(fract(q.x) * 6.0);\n        float py = floor(q.y * 7.0);\n        float glo = 0.0;\n        float ghi = 0.0;\n        if (ci > -0.5 && ci < 0.5) { glo = 139807.0; ghi = 31778.0; }\n        if (ci > 0.5 && ci < 1.5) { glo = 139807.0; ghi = 31778.0; }\n        if (ci > 1.5 && ci < 2.5) { glo = 139807.0; ghi = 31778.0; }\n        if (ci > 2.5 && ci < 3.5) { glo = 0.0; ghi = 6336.0; }\n        if (ci > 3.5 && ci < 4.5) { glo = 0.0; ghi = 6336.0; }\n        if (ci > 4.5 && ci < 5.5) { glo = 0.0; ghi = 6336.0; }\n        float hit = 0.0;\n        if (px < 5.0)\n\n        {\n            float b = py * 5.0 + px;\n            float word = b < 20.0 ? glo : ghi;\n            float shift = b < 20.0 ? b : b - 20.0;\n            hit = mod(floor(word / exp2(shift)), 2.0);\n        }\n        \n        Mask1 = max(Mask1, hit);\n    }\n}"
            },
            "Position": [
                80,
                -300
            ]
        },

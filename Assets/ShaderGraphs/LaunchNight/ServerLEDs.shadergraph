        {
            "Id": 7,
            "Type": "CustomFunction",
            "Settings": {
                "Name": "Leds",
                "Inputs": [
                    {
                        "Name": "UV",
                        "Type": "Vec2"
                    },
                    {
                        "Name": "Time",
                        "Type": "Float"
                    },
                    {
                        "Name": "Seed",
                        "Type": "Float"
                    },
                    {
                        "Name": "Alarm",
                        "Type": "Float"
                    }
                ],
                "Outputs": [
                    {
                        "Name": "Color",
                        "Type": "Vec3"
                    }
                ],
                "Code": "vec2 grid = vec2(6.0, 44.0);\nvec2 gp = UV * grid;\nvec2 cell = floor(gp);\nvec2 fp = fract(gp) - vec2_splat(0.5);\nfloat h = fract(sin(dot(cell + vec2_splat(Seed * 17.0), vec2(12.9898, 78.233))) * 43758.5453);\nfloat h2 = fract(h * 91.7);\nfloat rate = 0.4 + h2 * 7.0;\nfloat on = step(0.4, fract(Time * rate + h * 7.0));\nfloat led = 1.0 - smoothstep(0.16, 0.3, length(fp * vec2(1.0, 0.5)));\nvec3 col = h < 0.55 ? vec3(0.1, 1.0, 0.3) : (h < 0.82 ? vec3(1.0, 0.55, 0.08) : vec3(0.2, 0.5, 1.0));\nfloat present = step(0.3, fract(h * 13.1)) * step(0.06, UV.y) * step(UV.y, 0.94);\nfloat strobe = step(0.5, fract(Time * 2.2 + h * 0.15));\ncol = mix(col, vec3(1.0, 0.04, 0.02), Alarm);\non = mix(on, strobe, Alarm * step(0.25, h2));\nColor = col * led * on * present;"
            },
            "Position": [
                640,
                -110
            ]
        },

        {
            "Id": 18,
            "Type": "CustomFunction",
            "Settings": {
                "Name": "Masonry",
                "Inputs": [
                    {
                        "Name": "Position",
                        "Type": "Vec3"
                    },
                    {
                        "Name": "Normal",
                        "Type": "Vec3"
                    },
                    {
                        "Name": "BlockSize",
                        "Type": "Vec2"
                    },
                    {
                        "Name": "Gap",
                        "Type": "Float"
                    },
                    {
                        "Name": "FrameYaw",
                        "Type": "Float"
                    }
                ],
                "Outputs": [
                    {
                        "Name": "Mortar",
                        "Type": "Float"
                    },
                    {
                        "Name": "Bevel",
                        "Type": "Float"
                    },
                    {
                        "Name": "Block",
                        "Type": "Float"
                    }
                ],
                "Code": "float a = radians(FrameYaw);\nfloat c = cos(a);\nfloat s = sin(a);\nvec3 p = vec3(Position.x * c - Position.z * s, Position.y, Position.x * s + Position.z * c);\nvec3 n = abs(vec3(Normal.x * c - Normal.z * s, Normal.y, Normal.x * s + Normal.z * c));\nvec2 uv = n.y > 0.7 ? p.xz : (n.x > n.z ? p.zy : p.xy);\nvec2 size = n.y > 0.7 ? vec2_splat(BlockSize.x * 0.8) : BlockSize;\nvec2 q = uv / size;\nq.x += mod(floor(q.y), 2.0) * 0.5;\nvec2 cell = floor(q);\nvec2 f = fract(q);\nvec2 edge = min(f, vec2_splat(1.0) - f) * size;\nfloat d = min(edge.x, edge.y);\nMortar = 1.0 - smoothstep(Gap * 0.5, Gap * 0.5 + 0.012, d);\nBevel = smoothstep(Gap * 0.5, Gap * 0.5 + 0.07, d);\nBlock = fract(sin(dot(cell, vec2(12.9898, 78.233))) * 43758.5453);"
            },
            "Defaults": {
                "Gap": [
                    0.03,
                    0.03,
                    0.03,
                    0.03
                ]
            },
            "Position": [
                -1040,
                80
            ]
        },

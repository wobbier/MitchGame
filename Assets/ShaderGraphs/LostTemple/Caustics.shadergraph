        },
        {
            "Id": 11,
            "Type": "CustomFunction",
            "Settings": {
                "Name": "Caustics",
                "Inputs": [
                    {
                        "Name": "Position",
                        "Type": "Vec2"
                    },
                    {
                        "Name": "Time",
                        "Type": "Float"
                    }
                ],
                "Outputs": [
                    {
                        "Name": "Light",
                        "Type": "Float"
                    }
                ],
                "Code": "vec2 p = mod(Position * 6.2831853, vec2_splat(6.2831853)) - vec2_splat(250.0);\nvec2 i = p;\nfloat c = 1.0;\nfloat strength = 0.005;\nfor (int n = 0; n < 4; n++)\n{\n    float t = Time * (1.0 - (3.5 / float(n + 1)));\n    i = p + vec2(cos(t - i.x) + sin(t + i.y), sin(t - i.y) + cos(t + i.x));\n    c += 1.0 / length(vec2(p.x / (sin(i.x + t) / strength), p.y / (cos(i.y + t) / strength)));\n}\nc /= 4.0;\nc = 1.17 - pow(c, 1.4);\nLight = pow(abs(c), 8.0);"
            },
            "Position": [
                -200,
                -300
            ]
        },

        {
            "Id": 19,
            "Type": "CustomFunction",
            "Settings": {
                "Name": "BrightLight",
                "Inputs": [
                    {
                        "Name": "Threshold",
                        "Type": "Float"
                    }
                ],
                "Outputs": [
                    {
                        "Name": "Light",
                        "Type": "Vec3"
                    },
                    {
                        "Name": "Centre",
                        "Type": "Vec2"
                    }
                ],
                "Code": "// Samples the frame on a coarse grid (sgSceneColor is the target's scene-colour lookup): the light\n// above Threshold, its average colour and where on screen it sits. Fixed sample positions, so bright\n// points never leave ghost copies.\nvec3 sum = vec3_splat(0.0);\nvec2 centre = vec2_splat(0.0);\nfloat total = 0.0;\nfor (int y = 0; y < 4; y++)\n{\n    for (int x = 0; x < 6; x++)\n    {\n        vec2 uv = vec2((float(x) + 0.5) / 6.0, (float(y) + 0.5) / 4.0);\n        vec3 c = sgSceneColor(uv);\n        float l = max(dot(c, vec3(0.2126, 0.7152, 0.0722)) - Threshold, 0.0);\n        sum += c * l;\n        centre += uv * l;\n        total += l;\n    }\n}\nLight = sum / (24.0 * max(Threshold, 0.05));\nCentre = total > 0.0001 ? centre / total : vec2_splat(0.5);"
            },
            "Position": [
                -2160,
                -110
            ]
        },

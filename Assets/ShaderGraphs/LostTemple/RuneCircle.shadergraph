        },
        {
            "Id": 8,
            "Type": "CustomFunction",
            "Settings": {
                "Name": "RuneRing",
                "Inputs": [
                    {
                        "Name": "UV",
                        "Type": "Vec2"
                    },
                    {
                        "Name": "Time",
                        "Type": "Float"
                    },
                    {
                        "Name": "Speed",
                        "Type": "Float"
                    }
                ],
                "Outputs": [
                    {
                        "Name": "Mask",
                        "Type": "Float"
                    },
                    {
                        "Name": "Glow",
                        "Type": "Float"
                    }
                ],
                "Code": "vec2 p = UV - vec2_splat(0.5);\nfloat r = length(p) * 2.0;\nfloat a = atan2(p.y, p.x) * 0.15915494 + 0.5;\nfloat ring = 1.0 - smoothstep(0.0, 0.012, abs(r - 0.94));\nring += 1.0 - smoothstep(0.0, 0.008, abs(r - 0.79));\nring += 1.0 - smoothstep(0.0, 0.01, abs(r - 0.43));\nring += (1.0 - smoothstep(0.0, 0.006, abs(r - 0.36))) * 0.6;\nfloat turn = a + Time * Speed;\nfloat cell = floor(turn * 28.0);\nfloat seg = fract(turn * 28.0);\nfloat h = fract(sin(cell * 91.7) * 4375.85);\nfloat h2 = fract(sin(cell * 17.3 + 4.1) * 2953.31);\nfloat band = step(0.815, r) * step(r, 0.915);\nfloat stroke = step(0.22, seg) * step(seg, 0.32 + h * 0.45);\nfloat bar = step(abs(r - (0.83 + h2 * 0.06)), 0.007) * step(0.2, seg) * step(seg, 0.8);\nfloat glyph = band * max(stroke * step(0.3, h), bar);\nfloat spin = a * 6.2831853 - Time * Speed * 2.5;\nvec2 q = vec2(cos(spin), sin(spin)) * r;\nfloat star = 0.0;\nfor (int i = 0; i < 6; i++)\n{\n    float k = float(i) * 1.0471976;\n    vec2 d = vec2(cos(k), sin(k));\n    star += 1.0 - smoothstep(0.0, 0.01, abs(dot(q, vec2(-d.y, d.x))));\n}\nstar *= step(r, 0.43) * step(0.12, r);\nfloat core = 1.0 - smoothstep(0.0, 0.1, r);\nfloat pulse = 0.65 + 0.35 * sin(Time * 2.2 - r * 9.0);\nMask = clamp(ring + glyph + star * 0.8 + core, 0.0, 1.0) * step(r, 1.0);\nGlow = Mask * pulse;"
            },
            "Position": [
                360,
                -110
            ]
        },

body {
	font-family: Inter;
	font-size: 16px;
	color: #FFFFFF;
	width: 100%;
	height: 100%;
}

#example-title {
	display: block;
	margin-top: 50px;
	text-align: center;
	font-size: 48px;
}

#crosshair {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 38px;
	height: 60px;
	margin: -30px 0 0 -16px;
}

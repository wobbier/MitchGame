body {
	font-family: Inter;
	font-size: 16px;
	color: #FFFFFF;
	width: 100%;
	height: 100%;
}

#root {
	width: 100%;
	height: 100%;
}

#prompt {
	display: block;
	position: absolute;
	left: 0;
	right: 0;
	bottom: 18%;
	text-align: center;
	color: #FFE27A;
	font-size: 26px;
	font-effect: glow( 2px #000000 );
}

#machine {
	display: block;
	position: absolute;
	left: 50%;
	top: 14%;
	width: 520px;
	margin-left: -260px;
	padding: 18px 22px 22px;
	decorator: vertical-gradient( #8B1010 #4A0606 );
	border: 6px #F2C230;
	border-radius: 22px;
	text-align: center;
}

#title {
	display: block;
	font-size: 30px;
	color: #FFD84A;
	letter-spacing: 4px;
	font-effect: shadow( 0px 2px #660000 );
}

#credits {
	display: block;
	font-size: 16px;
	color: #FFE9B0;
	margin: 4px 0 12px;
}

#reels {
	display: flex;
	justify-content: space-between;
}

.reel {
	display: block;
	width: 140px;
	height: 150px;
	line-height: 150px;
	decorator: vertical-gradient( #DDDDDD #FFFFFF );
	border: 4px #222222;
	border-radius: 10px;
	font-size: 84px;
}

.reel.spinning {
	opacity: 0.7;
}

.sym { color: #222222; }
.s0 { color: #D01818; }
.s1 { color: #222222; font-size: 54px; }
.s2 { color: #E0258A; }

img.sym {
	width: 100px;
	height: 100px;
	vertical-align: middle;
}

#result {
	display: block;
	height: 40px;
	margin-top: 14px;
	font-size: 24px;
	color: #FFF3A0;
	white-space: nowrap;
}

#result.jackpot {
	color: #7DFF6A;
	font-size: 22px;
	animation: 0.25s infinite alternate flash;
}

@keyframes flash {
	from { opacity: 1; }
	to { opacity: 0.35; }
}

#hint {
	display: block;
	font-size: 13px;
	color: #F6CFCF;
}

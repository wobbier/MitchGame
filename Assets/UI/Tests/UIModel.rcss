body {
	font-family: Inter;
	font-size: 20px;
	color: #F2F4F8;
	width: 100%;
	height: 100%;
}

#panel {
	position: absolute;
	left: 160px;
	top: 90px;
	width: 480px;
	height: 260px;
	background-color: #14251BE6;
	border-radius: 16px;
	padding: 24px;
}

h1 {
	display: block;
	font-size: 32px;
	margin-bottom: 10px;
	color: #7BE495;
}

p {
	display: block;
	margin-bottom: 18px;
	color: #C9D8CE;
}

#bump {
	position: absolute;
	left: 24px;
	top: 170px;
	padding: 10px 20px;
	background-color: #2E7D5B;
	border-radius: 6px;
	color: #FFFFFF;
}

#bump:hover {
	background-color: #3B9A72;
}

body {
	font-family: Inter;
	font-size: 20px;
	color: #F2F4F8;
	width: 100%;
	height: 100%;
}

#panel {
	position: absolute;
	left: 180px;
	top: 80px;
	width: 600px;
	height: 380px;
	background-color: #1B2433E6;
	border-radius: 24px;
	padding: 24px;
}

/* RmlUi ships no default stylesheet: block elements must say so. */
h1 {
	display: block;
	font-size: 34px;
	margin-bottom: 8px;
	color: #FFD166;
}

p {
	display: block;
	margin-bottom: 20px;
	color: #B8C2D9;
}

/* An oversized gradient block clipped by the rounded parent: exercises the stencil clip mask. */
#clip-box {
	position: absolute;
	left: 24px;
	top: 140px;
	width: 240px;
	height: 150px;
	border-radius: 40px;
	overflow: hidden;
	background-color: #0D1117;
}

#clip-fill {
	position: absolute;
	left: -60px;
	top: -40px;
	width: 400px;
	height: 120px;
	background-color: #2EC4B6;
	transform: rotate(-12deg);
}

#clip-label {
	position: absolute;
	left: 48px;
	top: 108px;
	color: #FFFFFF;
}

#star {
	position: absolute;
	left: 320px;
	top: 150px;
	width: 96px;
	height: 96px;
}

#tilted {
	position: absolute;
	left: 300px;
	top: 270px;
	width: 220px;
	height: 56px;
	padding: 12px;
	background-color: #EF476F;
	border-radius: 8px;
	transform: rotate(6deg);
	color: #FFFFFF;
}

#press-me {
	position: absolute;
	left: 24px;
	top: 310px;
	padding: 10px 18px;
	background-color: #3A86FF;
	border-radius: 6px;
	color: #FFFFFF;
}

#press-me:hover {
	background-color: #5E9BFF;
}

#click-result {
	position: absolute;
	left: 160px;
	top: 320px;
	color: #B8C2D9;
}

/* Engine-native elements (UI-8). */
#feed {
	position: absolute;
	left: 440px;
	top: 140px;
	width: 160px;
	height: 90px;
	border-radius: 6px;
}

#engine-row {
	position: absolute;
	left: 440px;
	top: 236px;
	width: 260px;
	height: 40px;
}

#coin {
	width: 32px;
	height: 32px;
}

#hero {
	width: 40px;
	height: 40px;
	margin-left: 4px;
}

#jump-label {
	margin-left: 8px;
	color: #B8C2D9;
	font-size: 16px;
}

input-glyph {
	display: inline-block;
	padding: 2px 8px;
	background-color: #F2F4F8;
	border-radius: 4px;
	color: #1B2433;
	font-size: 15px;
}

<rml>
<head>
	<title>UITest</title>
	<link type="text/rcss" href="UITest.rcss"/>
</head>
<body>
	<div id="panel">
		<h1>MitchEngine × RmlUi</h1>
		<p>Text shaped by FreeType, drawn by bgfx.</p>
		<div id="clip-box">
			<div id="clip-fill"/>
			<span id="clip-label">rounded clip</span>
		</div>
		<img id="star" src="../Drive/Star.png"/>
		<div id="tilted">transform: rotate</div>
		<button id="press-me" onclick="set-text:#click-result|Clicked!">Press me</button>
		<span id="click-result">Unclicked</span>
		<!-- Engine-native elements (UI-8): a render texture's live feed, a sheet sprite, a flipbook, a binding. -->
		<viewport id="feed" src="Assets/Textures/RenderTexture/StudioFeed.rendertexture"/>
		<div id="engine-row">
			<sprite id="coin" sheet="Assets/Textures/Sprites/Coins.spritesheet" name="Coins_0"/>
			<sprite id="hero" anim="Assets/Textures/Sprites/Hero_Walk.spriteanim"/>
			<span id="jump-label">Jump <input-glyph id="jump" action="Jump"/></span>
		</div>
	</div>
</body>
</rml>

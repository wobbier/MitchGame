<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Command-line build of the game's scripts (every .cs under Assets) against ScriptCore; the engine
    runs it on Linux / macOS and for hot reload. Visual Studio uses the Sharpmake-generated project.
    MitchEngineDir is the engine: the project's Engine/ unless the engine passes another (an editor
    or Player from another checkout writes it to .tmp/MitchEngine.props too, for IDEs).
  -->
  <Import Project="../.tmp/MitchEngine.props" Condition="'$(MitchEngineDir)' == '' And Exists('../.tmp/MitchEngine.props')" />
  <PropertyGroup>
    <MitchEngineDir Condition="'$(MitchEngineDir)' == ''">$(MSBuildThisFileDirectory)../Engine/</MitchEngineDir>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Game.Script</AssemblyName>
    <Nullable>annotations</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/**/*.cs" />
    <ProjectReference Include="$(MitchEngineDir)Modules/ScriptCore/ScriptCore.csproj" />
  </ItemGroup>
  <!-- The CS-9 source generator: schemas + serializers for [GenerateSchema] scripts. -->
  <Import Project="$(MitchEngineDir)Modules/ScriptCore/Generators/MitchEngine.Generators.targets" />
</Project>
